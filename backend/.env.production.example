# ============================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ============================================
# Copy this file to .env on your VPS and update with real values.
# NEVER commit actual secrets to git!
# Set file permissions: chmod 600 .env

# Server
PORT=4050
NODE_ENV=production

# Database (MongoDB Atlas — use your production cluster)
MONGO_URI=mongodb+srv://username:password@your-cluster.mongodb.net/amezing_pay?retryWrites=true&w=majority

# Authentication Keys (Generate with: openssl rand -hex 64)
JWT_SECRET=generate_a_strong_random_128_char_hex_string
REFRESH_SECRET=generate_a_strong_random_128_char_hex_string
OTP_SECRET=generate_a_strong_random_64_char_hex_string

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SENDGRID_FROM_EMAIL=noreply@amezingpay.com

# SendGrid (Alternative to SMTP — only needed if not using SMTP)
# SENDGRID_API_KEY=SG.your_sendgrid_api_key

# ── Payment Gateway: Cashfree (PRIMARY — ACTIVE) ──
# Get PRODUCTION keys from: https://merchant.cashfree.com
CASHFREE_APP_ID=your_production_app_id
CASHFREE_SECRET_KEY=your_production_secret_key
CASHFREE_ENV=PRODUCTION

# ── Payment Gateway: Razorpay (LEGACY — kept for backward compat) ──
# These are required by env.js validation but not used in active payment flow.
# Set to your live keys if you have them, or keep test keys.
RAZORPAY_KEY_ID=rzp_live_your_key_or_test_key
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_from_razorpay_dashboard

# Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_UPLOAD_PRESET=your_preset
CLOUDINARY_FOLDER=amezingpay

# URLs (MUST match your actual domains)
APP_URL=https://amezingpay.com
API_URL=https://api.amezingpay.com

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=https://amezingpay.com,https://www.amezingpay.com,https://admin.amezingpay.com

# Logging
LOG_LEVEL=info
